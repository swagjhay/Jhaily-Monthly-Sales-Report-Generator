# Copy this file to .env and fill in your real values. Never commit the real .env file.

# Gmail address the app sends reports FROM (needs an App Password, not your normal password --
# requires 2-Step Verification enabled on the Google account first)
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# A long, random string used to sign session cookies. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_real_random_string

# A separate random secret that authorizes the monthly GitHub Actions workflow
# to trigger report generation. Generate the same way as SECRET_KEY, but use
# a DIFFERENT value -- never reuse one secret for two purposes.
SCHEDULER_SECRET=replace_with_a_different_random_string
